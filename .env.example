DATABASE_URL=sqlite:///subscriptions.db
SECRET_KEY=uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_PASSPHRASE_HASH=uv run python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('{your-passphrase}'))"
CALENDAR_FEED_TOKEN=uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_TIMEZONE=Europe/Bratislava